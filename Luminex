# Helper para n(%)
mk_npct <- function(n, total) {
  # n puede tener NA -> lo pasamos a 0 para el formato n(%)
  n <- ifelse(is.na(n), 0L, n)
  paste0(n, " (", sprintf("%.1f", 100 * n / ifelse(total > 0, total, NA_real_)), "%)")
}

