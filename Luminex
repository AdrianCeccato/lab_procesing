    Total_Samples = n(),
    
    # Bead Count (conteos)
    Good_Bead_Count_n             = sum(Quality_check_beads == "Good Bead Count",             na.rm = TRUE),
    Low_Bead_Count_n              = sum(Quality_check_beads == "Low Bead Count",              na.rm = TRUE),
    Low_Acceptable_Bead_Count_n   = sum(Quality_check_beads == "Low Acceptable Bead Count",   na.rm = TRUE),
    
    # Quality Check (conteos)
    Above_ULQ_extrap_n = sum(Quality_check == "Above ULQ - extrapolated based on standard curve", na.rm = TRUE),
    Above_ULQ_set_n    = sum(Quality_check == "Above ULQ - set to non-calculated ULQ",            na.rm = TRUE),
    Good_quality_n     = sum(Quality_check == "Good quality",                                      na.rm = TRUE),
    Under_LLQ_extrap_n = sum(Quality_check == "Under LLQ - extrapolated based on standard curve",  na.rm = TRUE),
    Under_LLQ_set_n    = sum(Quality_check == "Under LLQ - set to non-calculated LLQ",            na.rm = TRUE),
    .groups = "drop"
  )

