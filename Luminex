    `Low Acceptable Bead Count n(%)`   = mk_npct(Low_Acceptable_Bead_Count_n, Total_Samples),
    
    `Above ULQ - extrapolated based on standard curve n(%)` = mk_npct(Above_ULQ_extrap_n, Total_Samples),
    `Above ULQ - set to non-calculated ULQ n(%)`            = mk_npct(Above_ULQ_set_n,    Total_Samples),
    `Good quality n(%)`                                     = mk_npct(Good_quality_n,     Total_Samples),
    `Under LLQ - extrapolated based on standard curve n(%)` = mk_npct(Under_LLQ_extrap_n, Total_Samples),
