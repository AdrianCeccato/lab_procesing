setwd("")
# Helper para detectar muestras que contengan "BV"
is_bv_sample <- function(x) {
  grepl("BV", x, ignore.case = TRUE)
}



all_files <- list.files(pattern="\\.csv$")

all_results <- data.frame()

for(i in seq_along(all_files)){
  
  message("Procesando archivo: ", all_files[i])
  
  all <- lum_import(all_files[i])
  exp <- lum_export(all)
  
  data <- as.data.frame(exp$well)
  
  ###########################################################################
  ### 1. EXTRAER Plate_number Y Position DESDE TU FORMATO REAL ("P1_B1")
  ###########################################################################
  data$Plate_number <- as.numeric(sub("P", "", sub("_.*", "", data$well)))
  data$Position     <- sub(".*_", "", data$well)   # B1, C7, A12 …
  
  ###########################################################################
  ### 2. LIMPIEZA: eliminar standards, background y total events
  ###########################################################################
  data <- data[!grepl("Standard", data$sample), ]
  data <- data[!grepl("Background", data$sample), ]
  data <- data[!grepl("Total Events", data$analyte), ]
  
  # Mantener solo samples que contengan "BV"
  data <- data[is_bv_sample(data$sample), ]
  
  # Si no queda nada en este archivo, pasar al siguiente
  if (nrow(data) == 0) {
    message("No hay muestras BV en: ", all_files[i], ". Se omite.")
    next
  }
  
  
  colnames(data)[colnames(data)=="Result"] <- "result"
  data$count <- as.numeric(data$count)
  
  ###########################################################################
  ### 3. CALCULAR LLQ / ULQ (igual que tu script)
  ###########################################################################
  tmp_avg      <- as.data.frame(all[["dtblock"]][["Avg Result"]])
  tmp_expected <- as.data.frame(all[["dtblock"]][["Standard Expected Concentration"]])
  tmp_dilution <- as.numeric(all[["dtblock"]][["Dilution Factor"]][30,3])
  
  #### --- LLQ ---
  low_df <- rbind(
    subset(tmp_avg, Sample=="Standard7"),
    subset(tmp_avg, Sample=="Standard6"),
    subset(tmp_avg, Sample=="Standard5"),
    subset(tmp_avg, Sample=="Standard4")
  )
  low_df[,-1] <- lapply(low_df[,-1], as.numeric)
  
  low_min <- as.data.frame(lapply(low_df, min, na.rm=TRUE))
  colnames(low_min) <- colnames(tmp_avg)
  low_min$Sample <- NULL
  
  low_melt <- melt(low_min)
  low_df_m <- melt(low_df, id.vars="Sample")
  low_merge <- merge(low_df_m, low_melt, by=c("variable","value"))
  low_merge$value <- NULL
  
  tmp_e <- tmp_expected
  colnames(tmp_e)[1] <- "Sample"
  tmp_e_m <- melt(tmp_e, id.vars="Sample")
  
  LLQ_final <- merge(tmp_e_m, low_merge, by=c("Sample","variable"))
  LLQ_final$Sample <- NULL
  colnames(LLQ_final) <- c("analyte","LLQ")
  LLQ_final$LLQ <- as.numeric(LLQ_final$LLQ) * tmp_dilution
  
  #### --- ULQ ---
  hi_df <- rbind(
    subset(tmp_avg, Sample=="Standard4"),
    subset(tmp_avg, Sample=="Standard3"),
    subset(tmp_avg, Sample=="Standard2"),
    subset(tmp_avg, Sample=="Standard1")
  )
  hi_df[,-1] <- lapply(hi_df[,-1], as.numeric)
  
  hi_max <- as.data.frame(lapply(hi_df, max, na.rm=TRUE))
  colnames(hi_max) <- colnames(tmp_avg)
  hi_max$Sample <- NULL
  
  hi_melt <- melt(hi_max)
  hi_df_m <- melt(hi_df, id.vars="Sample")
  hi_merge <- merge(hi_df_m, hi_melt, by=c("variable","value"))
  hi_merge$value <- NULL
  
  tmp_e_m2 <- melt(tmp_e, id.vars="Sample")
  
  ULQ_final <- merge(tmp_e_m2, hi_merge, by=c("Sample","variable"))
  ULQ_final$Sample <- NULL
  colnames(ULQ_final) <- c("analyte","ULQ")
  ULQ_final$ULQ <- as.numeric(ULQ_final$ULQ) * tmp_dilution
  
  #### --- MERGE ---
  data$analyte <- as.character(data$analyte)
  LLQ_final$analyte  <- as.character(LLQ_final$analyte)
  ULQ_final$analyte  <- as.character(ULQ_final$analyte)
  LLQ_final <- LLQ_final %>%
    dplyr::group_by(analyte) %>%
    dplyr::summarise(LLQ = suppressWarnings(min(as.numeric(LLQ), na.rm = TRUE)), .groups = "drop")
  
  ULQ_final <- ULQ_final %>%
    dplyr::group_by(analyte) %>%
    dplyr::summarise(ULQ = suppressWarnings(max(as.numeric(ULQ), na.rm = TRUE)), .groups = "drop")
  
  data <- merge(data, LLQ_final, by="analyte")
  data <- merge(data, ULQ_final, by="analyte")
  
  ###########################################################################
  ### 4. QUALITY CHECK
  ###########################################################################

  # Patrones robustos para '>' y '<' al inicio (aceptan >, &gt;, &amp;gt; con espacios)
  pat_gt <- "^\\s*(?:&amp;gt;|&gt;|>)\\s*"
  pat_lt <- "^\\s*(?:&amp;lt;|&lt;|<)\\s*"
  
  is_gt <- grepl(pat_gt, data$result)
  is_lt <- grepl(pat_lt, data$result)
  
  # 1) Valor base sin símbolo (solo para los casos que no tienen >/<)
  stripped <- gsub(pat_gt, "", data$result)
  stripped <- gsub(pat_lt, "", stripped)
  val_base <- suppressWarnings(as.numeric(stripped))
  
  # 2) Imputación pedida:
  #    - si trae '>' → usar ULQ
  #    - si trae '<' → usar LLQ
  #    - si es numérico → usar el propio valor
  data$result_num <- ifelse(
    is_gt, data$ULQ,
    ifelse(is_lt, data$LLQ, val_base)
  )
  
  # 3) QC beads (igual que tu lógica)
  data$Quality_check_beads <- "Good Bead Count"
  data$Quality_check_beads <- ifelse(data$count < 50, "Low Acceptable Bead Count", data$Quality_check_beads)
  data$Quality_check_beads <- ifelse(data$count < 25, "Low Bead Count",           data$Quality_check_beads)
  
  # 4) QC por símbolo (con tus etiquetas originales)
  data$Quality_check <- "Good quality"
  data$Quality_check[is_gt] <- "Above ULQ - set to non-calculated ULQ"
  data$Quality_check[is_lt] <- "Under LLQ - set to non-calculated LLQ"
  
  # 5) Reglas 'Extrapolated' (manteniendo tu criterio)
  if ("comments" %in% colnames(data)) {
    data$Quality_check <- ifelse(
      data$comments == "Extrapolated" & !is.na(data$result_num) & !is.na(data$ULQ) & data$result_num > data$ULQ * 0.1,
      "Above ULQ - extrapolated based on standard curve",
      data$Quality_check
    )
    data$Quality_check <- ifelse(
      data$comments == "Extrapolated" & !is.na(data$result_num) & !is.na(data$LLQ) & data$result_num < data$LLQ * 10,
      "Under LLQ - extrapolated based on standard curve",
      data$Quality_check
    )
  }
  
  ###########################################################################
  ### 5. FORMATO FINAL (Concentration queda NUMÉRICA tras la imputación)
  ###########################################################################
  data <- data %>%
    rename(variable = analyte,
           Beads    = count) %>%
    mutate(
      Concentration = data$result_num  # ← numérica y ya imputada
    ) %>%
    select(Plate_number, Position, variable,
           Concentration,            # numérico final (sin símbolos)
           Beads, LLQ, ULQ,
           Quality_check_beads, Quality_check, sample)

  
  ###########################################################################
  ### 6. EXPORTAR
  ###########################################################################
  write.csv2(
    data,
    paste0(sub("\\.csv","",all_files[i]), "_PROCESSED.csv"),
    row.names = FALSE
  )
  
  all_results <- rbind(all_results, data)
}

