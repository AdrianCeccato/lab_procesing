# ====== Función robusta de tendencia por analito ======
fit_trend_once <- function(df_an) {
  # df_an: data.frame con columnas analyte, day, median_conc (un analito)
  an <- unique(df_an$analyte)
  x  <- df_an$day
  y  <- df_an$median_conc
  ux <- sort(unique(x))
  
  # si hay muy pocos días únicos, usar recta (lm). Si hay >=4, usar loess.
  if (length(ux) >= 4 && length(x) >= 4) {
    # loess estable: span relativamente alto + surface='direct' ayuda con ties
    mod <- try(loess(median_conc ~ day, data = df_an,
                     span = 0.8, degree = 1,
                     control = loess.control(surface = "direct")),
               silent = TRUE)
    if (inherits(mod, "try-error")) {
      # Fallback a lineal en caso de fallo
      mod <- lm(median_conc ~ day, data = df_an)
      xnew <- seq(min(x), max(x), length.out = 100)
      yhat <- as.numeric(predict(mod, newdata = data.frame(day = xnew)))
      tibble(analyte = an, day = xnew, trend = yhat, method = "lm_fallback")
    } else {
      xnew <- seq(min(x), max(x), length.out = 200)
      yhat <- as.numeric(predict(mod, newdata = data.frame(day = xnew)))
      tibble(analyte = an, day = xnew, trend = yhat, method = "loess")
    }
  } else if (length(ux) >= 2) {
    mod <- lm(median_conc ~ day, data = df_an)
    xnew <- seq(min(x), max(x), length.out = 100)
    yhat <- as.numeric(predict(mod, newdata = data.frame(day = xnew)))
    tibble(analyte = an, day = xnew, trend = yhat, method = "lm")
  } else {
    # 1 único día → trazo horizontal en ese punto
    tibble(analyte = an, day = ux, trend = y, method = "point")
  }
}

